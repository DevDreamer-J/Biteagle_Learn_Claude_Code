# OpenAI 兼容接口配置（s01–s17 所有示例统一读取以下三个必需项）

# API Key（必需）
API_KEY=sk-xxx

# OpenAI 兼容接口地址（必需，注意末尾为 /compatible-mode/v1）
OpenAI_BASE_URL=https://your-endpoint.maas.aliyuncs.com/compatible-mode/v1

# 主模型 ID（必需）
LLM_DEEPSEEK_MODEL=deepseek-v4.1-flash-1017

# ======================== 可选项 ========================

# 备用模型：s15 主模型调用失败时回退
# FALLBACK_MODEL_ID=qwen3.8-max-0902

# s17 目标循环的独立评估器模型（默认与主模型相同）
# GOAL_EVALUATOR_MODEL_ID=

# s17 最大轮数限制（0 = 不限制）
# MAX_TURNS=0
